{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true,
    "paths": {
      "@/*": ["../../src/*"]
    },
    "types": ["node", "react", "react-dom"]
  },
  "include": [".storybook/**/*", "stories/**/*"],
  "exclude": ["node_modules"]
}
