{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vitest"],
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../src/**/*.ts",
    "../src/**/*.tsx",
    "../packages/*/src/**/*.ts",
    "../packages/*/src/**/*.tsx"
  ],
  "exclude": ["../node_modules"]
}
