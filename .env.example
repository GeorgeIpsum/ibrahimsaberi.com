# Wisp proxy endpoint for the /yt-dlp-test route's libcurl.js networking.
# Unset => the public demo (wss://wisp.mercurywork.shop/), which is for testing
# only. Point this at your own server — see services/wisp-server.
# NEXT_PUBLIC_WISP_URL=ws://localhost:6001/

# Optional: shared secret, sent as ?token=, if your Wisp server sets WISP_TOKEN.
# (NEXT_PUBLIC_* is embedded in the browser bundle, so it is not a real secret —
# use ALLOWED_ORIGINS on the server to gate a public site.)
# NEXT_PUBLIC_WISP_TOKEN=
