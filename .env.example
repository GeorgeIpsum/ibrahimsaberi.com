# Wisp proxy endpoint for the /yt-dlp-test route's libcurl.js networking.
# Unset => the public demo (wss://wisp.mercurywork.shop/), which is for testing
# only. Point this at your own server — see services/wisp-server.
# NEXT_PUBLIC_WISP_URL=ws://localhost:6001/

# Optional: shared secret, sent as ?token=, if your Wisp server sets WISP_TOKEN.
# (NEXT_PUBLIC_* is embedded in the browser bundle, so it is not a real secret —
# use ALLOWED_ORIGINS on the server to gate a public site.)
# NEXT_PUBLIC_WISP_TOKEN=

# yt-dlp-wasm asset sources (consumed by src/services/yt-dlp). All optional.
#
# Back the same-origin package + wheel paths with an external origin (e.g. an R2
# public bucket) via a Next rewrite. The package + its workers MUST stay
# same-origin (Workers can't load cross-origin), so this is a server-side
# rewrite, not a client URL. Server var (no NEXT_PUBLIC_).
# YTDLP_ASSET_ORIGIN=https://assets.example.com
#
# Cross-origin overrides for individually-fetched assets (need CORS):
# NEXT_PUBLIC_YTDLP_WHEEL_BASE=https://assets.example.com/yt-dlp-wheels
# NEXT_PUBLIC_YTDLP_PYODIDE_URL=https://assets.example.com/pyodide/v.../full/
# NEXT_PUBLIC_YTDLP_FFMPEG_BASE=https://assets.example.com/ffmpeg-core/esm
