{
  "css": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineEnding": "lf",
      "trailingNewline": true
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@base-ui/react", "@base-ui/react/*"],
                "message": "Import Base UI primitives only through src/atoms. Add or extend a wrapper there, then import from @/atoms/..."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/atoms/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
